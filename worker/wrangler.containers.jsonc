{
  // All-Cloudflare deployment (requires Workers Paid for Containers):
  //   npx wrangler deploy -c wrangler.containers.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadence",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  "containers": [
    { "class_name": "CadenceApp", "image": "../Dockerfile", "max_instances": 2, "instance_type": "basic" }
  ],
  "durable_objects": { "bindings": [{ "name": "CADENCE_APP", "class_name": "CadenceApp" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CadenceApp"] }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cadence",
      "database_id": "18028a1f-657c-48b6-9dc9-955ff40b2970",
      "migrations_dir": "../db/migrations"
    }
  ],
  // The app calls back into this same Worker for /internal/d1/*.
  "vars": { "PUBLIC_URL": "https://cadence.<your-subdomain>.workers.dev" }
  // Secret: INTERNAL_TOKEN
}
