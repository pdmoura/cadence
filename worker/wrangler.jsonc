{
  // Free-plan deployment: Worker + D1 only. The ASP.NET Core app runs on Render (see ../render.yaml)
  // and reaches D1 through this Worker. For the all-Cloudflare setup, use wrangler.containers.jsonc.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadence-d1",
  "main": "src/proxy.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "workers_dev": true,

  // Same SQL files the app applies to SQLite locally.
  //   npx wrangler d1 migrations apply cadence --local    (no account needed)
  //   npx wrangler d1 migrations apply cadence --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cadence",
      "database_id": "18028a1f-657c-48b6-9dc9-955ff40b2970",
      "migrations_dir": "../db/migrations"
    }
  ]
  // Secret (npx wrangler secret put INTERNAL_TOKEN). Locally it comes from .dev.vars.
}
