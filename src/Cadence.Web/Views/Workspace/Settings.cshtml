@model WorkspaceViewModel
@{
    ViewData["Title"] = "Settings";
    ViewData["Eyebrow"] = string.IsNullOrWhiteSpace(Model.Settings.WorkspaceName) ? "Set up your workspace" : Model.Settings.WorkspaceName;
    var tabs = new[]
    {
        ("workspace", "Business"), ("team", "Team"), ("goals", "Goals"), ("sources", "Lead sources"), ("ai", "AI"), ("appearance", "Appearance"),
    };
}
@section Actions {
    <a class="btn btn-secondary" href="/setup"><svg class="ic" viewBox="0 0 24 24"><path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/></svg><span class="label">Run setup wizard</span></a>
}

<div class="settings-grid">
    <nav class="settings-nav" aria-label="Settings sections">
        @foreach (var (key, label) in tabs)
        {
            <a class="@(Model.Tab == key ? "is-active" : "")" href="/settings?tab=@key">@label</a>
        }
    </nav>

    <div class="card">
        <div class="card-head">
            <h2 class="card-title">@tabs.First(t => t.Item1 == Model.Tab).Item2</h2>
        </div>
        <div class="card-body">
            @switch (Model.Tab)
            {
                case "team": await Html.RenderPartialAsync("_Team", Model); break;
                case "goals": await Html.RenderPartialAsync("_Goals", Model); break;
                case "sources": await Html.RenderPartialAsync("_Sources", Model); break;
                case "ai": await Html.RenderPartialAsync("_Ai", Model); break;
                case "appearance":
                    <div class="stack" style="gap:12px">
                        <p class="muted">Choose how Cadence looks on this device.</p>
                        <div class="theme-switch wide" role="group" aria-label="Theme">
                            <button type="button" data-theme-set="light" aria-pressed="false"><svg class="ic" viewBox="0 0 24 24"><path d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>Light</button>
                            <button type="button" data-theme-set="dark" aria-pressed="false"><svg class="ic" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>Dark</button>
                            <button type="button" data-theme-set="system" aria-pressed="true"><svg class="ic" viewBox="0 0 24 24"><path d="M4 5h16v11H4zM8 21h8M12 16v5"/></svg>System</button>
                        </div>
                    </div>
                    break;
                default: await Html.RenderPartialAsync("_Workspace", Model); break;
            }
        </div>
    </div>
</div>
