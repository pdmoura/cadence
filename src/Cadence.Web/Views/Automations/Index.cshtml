@model AutomationsViewModel
@{
    ViewData["Title"] = "Automations";
    ViewData["Eyebrow"] = "Webhooks & integrations";
}

<section class="grid grid-3-2">
    <div class="card">
        <div class="card-head"><div><h2>Inbound lead webhook</h2><p class="sub">Website forms, ad platforms and Zapier post here. Signed, de-duplicated by email, enriched, logged.</p></div></div>
        <div class="card-body" style="display:grid;gap:14px">
            <dl class="dl">
                <dt>Endpoint</dt><dd><code>POST /webhooks/leads</code></dd>
                <dt>Signature</dt><dd><code>X-Cadence-Signature: sha256=HMAC_SHA256(secret, raw body)</code></dd>
                <dt>Secret</dt><dd>@if (Model.SecretConfigured) { <span class="badge badge-success">configured</span> } else { <span class="badge badge-danger">missing (Webhooks:Secret)</span> }</dd>
                <dt>Responses</dt><dd><code>201 created</code> · <code>200 duplicate</code> · <code>401 invalid signature</code> · <code>400 bad payload</code></dd>
            </dl>
            <div>
                <div class="field"><label>Example body</label></div>
                <pre class="report" id="wh-body">@Model.ExampleBody</pre>
            </div>
            <div>
                <div class="field"><label>Signature for that exact body with the current secret</label></div>
                <pre class="report" id="wh-sig">@Model.ExampleSignature</pre>
            </div>
            <div class="callout">Try it locally:<br /><code>curl -X POST http://localhost:8080/webhooks/leads -H "Content-Type: application/json" -H "X-Cadence-Signature: @Model.ExampleSignature" -d '@Model.ExampleBody'</code></div>
        </div>
    </div>

    <div class="card" style="align-self:start">
        <div class="card-head"><div><h2>What is automated today</h2></div></div>
        <div class="card-body">
            <div class="stat-row"><span class="name">Lead intake from forms</span><span class="badge badge-success no-dot">live</span></div>
            <div class="stat-row"><span class="name">Website + industry + phone normalisation (rules)</span><span class="badge badge-success no-dot">live</span></div>
            <div class="stat-row"><span class="name">LLM field proposals with human review</span><span class="badge badge-brand no-dot">optional</span></div>
            <div class="stat-row"><span class="name">Daily management report from stand-ups</span><span class="badge badge-success no-dot">live</span></div>
            <div class="stat-row"><span class="name">Reply detection from mailbox</span><span class="badge badge-neutral no-dot">next</span></div>
        </div>
    </div>
</section>

<section class="card">
    <div class="card-head"><div><h2>Delivery log</h2><p class="sub">Last 50 deliveries, including the ones that were rejected.</p></div></div>
    <div class="card-body flush">
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>Received</th><th>Source</th><th>Event</th><th>Signature</th><th>Result</th><th>Payload</th></tr></thead>
                <tbody>
                @foreach (var d in Model.Deliveries)
                {
                    <tr>
                        <td class="cell-muted" style="white-space:nowrap">@d.ReceivedAt.ToString("d MMM HH:mm")</td>
                        <td>@d.Source</td>
                        <td class="mono">@d.Event</td>
                        <td>@if (d.SignatureValid) { <span class="badge badge-success">valid</span> } else { <span class="badge badge-danger">invalid</span> }</td>
                        <td>
                            <span class="badge @(d.Status == "accepted" ? "badge-success" : d.Status == "rejected" ? "badge-danger" : "badge-warning") no-dot">@d.Status</span>
                            <div class="cell-sub">@if (d.LeadId is { } id) { <a href="/leads/@id">@d.Detail</a> } else { @d.Detail }</div>
                        </td>
                        <td><code style="display:block;max-width:360px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@d.Payload">@d.Payload</code></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
