@inject Cadence.Web.Services.CurrentMember Current
@inject MemberRepository Members
@{
    var me = await Current.GetAsync();
    var team = await Members.AllAsync();
    var path = Context.Request.Path.Value ?? "/";
    string Active(string prefix) => (prefix == "/" ? path == "/" : path.StartsWith(prefix)) ? "is-active" : "";
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(title is null ? "Cadence" : $"{title} · Cadence")</title>
    <meta name="description" content="Cadence: SDR pipeline, AI-assisted lead research with human validation, daily stand-ups and management reports." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true" />
</head>
<body>
<div class="shell">
    <aside class="sidebar" aria-label="Main navigation">
        <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 32 32" width="32" height="32"><rect width="32" height="32" rx="9" fill="#3B5BDB"/><path d="M9 20.5c2.6 0 3.6-9 6.5-9s3.6 9 7.5 9" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/></svg>
            </span>
            <span class="brand-text">Cadence<small>SDR workbench</small></span>
        </a>

        <nav class="nav">
            <a class="nav-link @Active("/")" href="/"><svg class="ic" viewBox="0 0 24 24"><path d="M4 13h6V4H4zM14 20h6v-9h-6zM4 20h6v-5H4zM14 8h6V4h-6z"/></svg>Dashboard</a>
            <a class="nav-link @Active("/leads")" href="/leads"><svg class="ic" viewBox="0 0 24 24"><path d="M16 11a4 4 0 1 0-8 0 4 4 0 0 0 8 0zM4 21v-1a5 5 0 0 1 5-5h6a5 5 0 0 1 5 5v1"/></svg>Leads</a>
            <a class="nav-link @Active("/standups")" href="/standups"><svg class="ic" viewBox="0 0 24 24"><path d="M12 6v6l4 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>Stand-ups</a>
            <a class="nav-link @Active("/automations")" href="/automations"><svg class="ic" viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>Automations</a>
            <a class="nav-link @Active("/reports")" href="/reports"><svg class="ic" viewBox="0 0 24 24"><path d="M4 19h16M7 16V9M12 16V5M17 16v-4"/></svg>Reports</a>
        </nav>

        <div class="sidebar-foot">
            <form method="post" action="/session/member" class="member-switch">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@(path + Context.Request.QueryString)" />
                <label class="member-label" for="member">Acting as</label>
                <div class="member-row">
                    <span class="avatar" aria-hidden="true">@(me?.Initials ?? "?")</span>
                    <select id="member" name="memberId" class="member-select" onchange="this.form.submit()" aria-label="Acting as team member">
                        @foreach (var m in team)
                        {
                            <option value="@m.Id" selected="@(me?.Id == m.Id)">@m.Name · @m.RoleLabel</option>
                        }
                    </select>
                </div>
            </form>
            <a class="foot-link" href="https://github.com/pdmoura/cadence" target="_blank" rel="noopener">Source on GitHub</a>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <button class="menu-btn" type="button" aria-label="Open navigation" data-toggle-nav>
                <svg viewBox="0 0 24 24" class="ic"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <div class="topbar-title">
                @if (ViewData["Eyebrow"] is string eyebrow) { <span class="eyebrow">@eyebrow</span> }
                <h1>@(title ?? "Dashboard")</h1>
            </div>
            <div class="topbar-actions">@RenderSection("Actions", required: false)</div>
        </header>

        @if (TempData["toast"] is string toast) { <div class="toast" role="status" data-toast>@toast</div> }
        @if (TempData["error"] is string err) { <div class="toast is-error" role="alert" data-toast>@err</div> }

        <main class="content">
            @RenderBody()
        </main>
    </div>
</div>
<div class="scrim" data-scrim></div>
<script src="/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
