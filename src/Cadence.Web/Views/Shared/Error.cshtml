@model int
@{
    ViewData["Title"] = Model == 404 ? "Not found" : "Something went wrong";
    ViewData["Eyebrow"] = $"HTTP {Model}";
}
<div class="card" style="max-width:560px">
    <div class="card-body" style="padding-top:20px">
        <p>@(Model == 404 ? "That page does not exist. The link may be old or the lead was removed." : "The request failed on our side. The error is logged; try again in a moment.")</p>
        <div class="form-actions" style="justify-content:flex-start"><a class="btn btn-primary" href="/">Back to the dashboard</a></div>
    </div>
</div>
