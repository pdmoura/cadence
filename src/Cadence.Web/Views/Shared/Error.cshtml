@model int
@{
    ViewData["Title"] = Model == 404 ? "Page not found" : "Something went wrong";
}
<div class="card" style="max-width:520px">
    <div class="card-body" style="padding-top:22px">
        <p class="muted" style="margin-bottom:18px">@(Model == 404 ? "That page does not exist. The link may be old or the lead was removed." : "The request failed on our side. It has been logged; try again in a moment.")</p>
        <a class="btn btn-primary" href="/">Back home</a>
    </div>
</div>
