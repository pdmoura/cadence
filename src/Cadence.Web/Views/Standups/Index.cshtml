@model StandupsViewModel
@{
    ViewData["Title"] = "Stand-up";
    var mine = Model.Mine;
    var today = DateTime.UtcNow.ToString("yyyy-MM-dd");
    static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));
    static string Role(string r) => r == "team_lead" ? "Team Lead" : r == "sdr" ? "SDR" : "Developer";
}
@section Meta { <span>@DateTime.Parse(Model.Day).ToString("dddd, d MMMM")</span><span class="faint sep">·</span><span class="num">@Model.Standups.Count of @Model.Team.Count posted</span> }
@section Actions {
    <a class="btn btn-secondary" href="/standups/report.txt?day=@Model.Day" target="_blank"><svg class="ic" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6"/></svg><span class="label">Plain text</span></a>
}

<section class="card">
    <div class="card-head">
        <div>
            <h2 class="card-title">@Model.RangeLabel</h2>
            <p class="hint" style="margin-top:2px">Each dot is a team member. Filled means they posted that day.</p>
        </div>
        <div class="chips">
            <a class="btn btn-ghost btn-sm" href="/standups?day=@Model.EarlierDay" aria-label="Earlier weeks"><svg class="ic" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg><span class="label">Earlier</span></a>
            <a class="btn btn-secondary btn-sm" href="/standups">Today</a>
            @if (Model.LaterDay is not null) { <a class="btn btn-ghost btn-sm" href="/standups?day=@Model.LaterDay" aria-label="Later weeks"><span class="label">Later</span><svg class="ic" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></a> }
        </div>
    </div>
    <div class="card-body">
        <div class="cal" aria-label="Stand-up calendar">
            @foreach (var w in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" }) { <span class="cal-head">@w</span> }
            @foreach (var d in Model.Calendar)
            {
                var cls = $"cal-day{(d.IsToday ? " is-today" : "")}{(d.IsSelected ? " is-selected" : "")}{(d.IsWeekend ? " is-weekend" : "")}{(d.Posted > 0 && d.Posted >= d.TeamSize ? " is-full" : "")}";
                if (d.IsFuture)
                {
                    <span class="@cls is-future" aria-disabled="true"><span class="d">@d.Date.Day</span></span>
                }
                else
                {
                    <a class="@cls" href="/standups?day=@d.Key" aria-current="@(d.IsSelected ? "date" : null)" aria-label="@d.Date.ToString("dddd d MMMM"): @d.Posted of @d.TeamSize posted">
                        <span class="d">@d.Date.Day@if (d.Date.Day == 1 || d == Model.Calendar[0]) { <small>@d.Date.ToString("MMM")</small> }</span>
                        @if (!d.IsWeekend || d.Posted > 0)
                        {
                            <span class="dots" aria-hidden="true">@for (var i = 0; i < d.TeamSize; i++) { <i class="@(i < d.Posted ? "on" : "")"></i> }</span>
                            <span class="c">@(d.Posted == 0 ? "none" : $"{d.Posted}/{d.TeamSize}")</span>
                        }
                    </a>
                }
            }
        </div>
    </div>
</section>

<section class="grid grid-main">
    <div class="stack">
        @if (Model.Me is not null && Model.IsToday)
        {
            <div class="card">
                <details class="disclosure" @(mine is null ? "open" : "")>
                    <summary class="card-head" style="padding-bottom:18px">
                        <h2 class="card-title"><span class="avatar sm" aria-hidden="true">@Model.Me.Initials</span>@(mine is null ? "Your stand-up" : "Your stand-up is posted")</h2>
                        <span class="btn btn-secondary btn-sm"><span class="when-closed">Edit</span><span class="when-open">@(mine is null ? "Five questions" : "Close")</span></span>
                    </summary>
                    <div class="card-body" style="padding-top:0">
                        <form method="post" action="/standups" class="stack" style="gap:14px">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="day" value="@Model.Day" />
                            <div class="field"><label for="yesterday">What did I accomplish yesterday?</label><textarea id="yesterday" name="yesterday" class="textarea" rows="2">@mine?.Yesterday</textarea></div>
                            <div class="field"><label for="today">What will I accomplish today?</label><textarea id="today" name="today" class="textarea" rows="2" required>@mine?.Today</textarea></div>
                            <div class="form-grid">
                                <div class="field"><label for="metric">Measurable result</label><input id="metric" name="metric" class="input" value="@mine?.Metric" placeholder="15 touches, 2 replies" /></div>
                                <div class="field"><label for="blockers">Blocked by</label><input id="blockers" name="blockers" class="input" value="@mine?.Blockers" placeholder="Nothing" /></div>
                                <div class="field span-2"><label for="help">Help I need</label><input id="help" name="help" class="input" value="@mine?.HelpNeeded" /></div>
                            </div>
                            <div class="form-actions"><button class="btn btn-primary" type="submit">@(mine is null ? "Post" : "Save")</button></div>
                        </form>
                    </div>
                </details>
            </div>
        }

        <div class="card">
            <div class="card-head"><h2 class="card-title">Team</h2></div>
            <div class="card-body flush">
                @foreach (var s in Model.Standups)
                {
                    <div class="standup">
                        <div class="who"><span class="avatar" aria-hidden="true">@Initials(s.MemberName)</span><div><b>@s.MemberName</b><span>@Role(s.MemberRole) · @s.UpdatedAt.ToString("HH:mm")</span></div></div>
                        <dl class="qa">
                            <dt>Today</dt><dd>@s.Today</dd>
                            @if (!string.IsNullOrWhiteSpace(s.Metric)) { <dt>Target</dt><dd>@s.Metric</dd> }
                            @if (!string.IsNullOrWhiteSpace(s.Yesterday)) { <dt>Yesterday</dt><dd class="muted">@s.Yesterday</dd> }
                            @if (!string.IsNullOrWhiteSpace(s.Blockers)) { <dt>Blocked</dt><dd class="blocker">@s.Blockers</dd> }
                            @if (!string.IsNullOrWhiteSpace(s.HelpNeeded)) { <dt>Needs</dt><dd>@s.HelpNeeded</dd> }
                        </dl>
                    </div>
                }
                @foreach (var m in Model.Team.Where(m => Model.Standups.All(s => s.MemberId != m.Id)))
                {
                    <div class="standup idle">
                        <div class="who"><span class="avatar idle" aria-hidden="true">@m.Initials</span><div><b style="color:var(--muted)">@m.Name</b><span>@m.RoleLabel</span></div></div>
                        <p>Not posted yet</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card sticky">
        <div class="card-head">
            <h2 class="card-title">Report for management</h2>
            <div class="chips">
                <button class="btn btn-secondary btn-sm" type="button" data-copy="#report">Copy</button>
                @if (Model.CanSend)
                {
                    <form method="post" action="/standups/send" class="inline-form" data-loading>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="day" value="@Model.Day" />
                        <button class="btn btn-primary btn-sm" type="submit"><span>Send to channel</span></button>
                    </form>
                }
            </div>
        </div>
        <div class="card-body"><pre class="report" id="report">@Model.Report</pre></div>
    </div>
</section>
