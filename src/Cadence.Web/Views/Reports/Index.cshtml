@model ReportsViewModel
@{
    ViewData["Title"] = "Reports";
    ViewData["Eyebrow"] = "Last 14 days, counted from the audit trail.";
    var max = Math.Max(1, Model.Max);
    int Px(int v) => (int)Math.Round(v * 160.0 / max);
    var total = Math.Max(1, Model.ByStage.Values.Sum());
    string Color(Stage s) => s switch { Stage.New => "var(--new)", Stage.Researching => "var(--research)", Stage.Validated => "var(--validated)", Stage.Contacted => "var(--contacted)", Stage.Qualified => "var(--qualified)", _ => "var(--dq)" };
}

<section class="grid grid-kpi">
    <div class="card stat"><span class="stat-label">Validated</span><span class="stat-value">@Model.Total(Stage.Validated)</span></div>
    <div class="card stat"><span class="stat-label">Contacted</span><span class="stat-value">@Model.Total(Stage.Contacted)</span></div>
    <div class="card stat"><span class="stat-label">Qualified</span><span class="stat-value">@Model.Total(Stage.Qualified)</span></div>
    <div class="card stat"><span class="stat-label">Suggestions accepted</span><span class="stat-value">@((int)(Model.AcceptanceRate * 100))%</span><span class="stat-hint">@Model.Suggestions.Accepted of @(Model.Suggestions.Accepted + Model.Suggestions.Rejected) reviewed</span></div>
</section>

<section class="grid grid-main">
    <div class="card">
        <div class="card-head">
            <h2 class="card-title">Daily progress</h2>
            <div class="keys hide-sm"><span><i style="background:var(--validated)"></i>Validated</span><span><i style="background:var(--contacted)"></i>Contacted</span><span><i style="background:var(--qualified)"></i>Qualified</span></div>
        </div>
        <div class="card-body">
            <div class="bars" role="img" aria-label="Stage transitions per day">
                @for (var i = 0; i < Model.Days.Count; i++)
                {
                    var any = Model.PerDay[Stage.Validated][i] + Model.PerDay[Stage.Contacted][i] + Model.PerDay[Stage.Qualified][i] > 0;
                    <div class="bar @(any ? "" : "empty-bar")" title="@Model.Days[i]: @Model.PerDay[Stage.Validated][i] validated, @Model.PerDay[Stage.Contacted][i] contacted, @Model.PerDay[Stage.Qualified][i] qualified">
                        @if (!any) { <span></span> }
                        @if (Model.PerDay[Stage.Qualified][i] > 0) { <span class="qualified" style="height:@Px(Model.PerDay[Stage.Qualified][i])px"></span> }
                        @if (Model.PerDay[Stage.Contacted][i] > 0) { <span class="contacted" style="height:@Px(Model.PerDay[Stage.Contacted][i])px"></span> }
                        @if (Model.PerDay[Stage.Validated][i] > 0) { <span class="validated" style="height:@Px(Model.PerDay[Stage.Validated][i])px"></span> }
                    </div>
                }
            </div>
            <div class="bar-labels">@foreach (var d in Model.Days) { <span>@DateTime.Parse(d).ToString("d/M")</span> }</div>
        </div>
    </div>

    <div class="stack">
        <div class="card">
            <div class="card-head"><h2 class="card-title">Pipeline now</h2></div>
            <div class="card-body" style="padding-top:6px">
                @foreach (var s in Stages.Ordered)
                {
                    <div class="meter"><span class="muted" style="font-weight:600">@s.Label()</span><span class="track"><b style="width:@(Model.ByStage[s] * 100 / total)%;background:@Color(s)"></b></span><span class="v">@Model.ByStage[s]</span></div>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-head"><h2 class="card-title">By owner</h2></div>
            <div class="card-body" style="padding-top:4px">
                @foreach (var (m, open, q) in Model.ByOwner)
                {
                    <div class="kv"><span class="avatar sm" aria-hidden="true">@m.Initials</span><span class="k">@m.Name</span><span class="muted num">@open open</span><span class="badge badge-qualified">@q won</span></div>
                }
            </div>
        </div>
    </div>
</section>
