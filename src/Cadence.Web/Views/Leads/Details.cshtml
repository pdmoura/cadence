@model LeadDetailViewModel
@{
    var l = Model.Lead;
    ViewData["Title"] = l.Company;
    var next = l.Stage.AllowedNext();
    var order = new[] { Stage.New, Stage.Researching, Stage.Validated, Stage.Contacted, Stage.Qualified };
    var reached = l.Stage == Stage.Disqualified ? order.Length : Array.IndexOf(order, l.Stage) + 1;
    var pending = Model.Pending.ToList();
}
@section Meta {
    <span class="badge badge-@l.Stage.Key()"><span class="dot"></span>@l.Stage.Label()</span>
    <span>@(l.ContactName ?? "No contact")@(l.ContactTitle is null ? "" : $", {l.ContactTitle}")</span>
    <span class="faint sep">·</span><span class="muted">from @l.Source</span>
}
@section Actions {
    <a class="btn btn-secondary" href="/leads/@l.Id/edit"><svg class="ic" viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg><span class="label">Edit</span></a>
    <form method="post" action="/leads/@l.Id/enrich" class="inline-form">
        @Html.AntiForgeryToken()
        <button class="btn btn-primary" type="submit"><svg class="ic" viewBox="0 0 24 24"><path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/></svg><span class="label">Suggest enrichment</span></button>
    </form>
}

<section class="grid grid-main">
    <div class="stack">
        @if (pending.Count > 0)
        {
            <div class="card" style="border-color:#f6d9a6">
                <div class="card-head">
                    <h2 class="card-title">Review suggestions <span class="pill">@pending.Count</span></h2>
                    <span class="muted hide-sm">Nothing is saved until you accept</span>
                </div>
                <div class="card-body flush">
                    @foreach (var s in pending)
                    {
                        <div class="suggestion">
                            <div class="what">
                                <div class="field-name">@s.FieldLabel</div>
                                <div class="values">
                                    @if (!string.IsNullOrEmpty(s.CurrentValue)) { <span class="old">@s.CurrentValue</span><span class="faint">→</span> }
                                    <span>@s.SuggestedValue</span>
                                </div>
                                @if (!string.IsNullOrEmpty(s.Rationale)) { <div class="why">@s.Rationale</div> }
                                <div class="meta">
                                    <span class="badge @(s.Source == "llm" ? "badge-brand" : "badge-neutral")">@(s.Source == "llm" ? "LLM" : s.Source == "webhook" ? "Webhook" : "Rule")</span>
                                    <span class="score"><i><b style="width:@((int)(s.Confidence * 100))%"></b></i><span class="muted" style="font-weight:600">@((int)(s.Confidence * 100))%</span></span>
                                </div>
                            </div>
                            <div class="actions">
                                <form method="post" action="/leads/@l.Id/suggestions/@s.Id">@Html.AntiForgeryToken()<input type="hidden" name="decision" value="reject" /><button class="btn btn-danger btn-sm" type="submit">Reject</button></form>
                                <form method="post" action="/leads/@l.Id/suggestions/@s.Id">@Html.AntiForgeryToken()<input type="hidden" name="decision" value="accept" /><button class="btn btn-success btn-sm" type="submit">Accept</button></form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card">
            <div class="card-head">
                <h2 class="card-title">Details</h2>
                <div class="ring" style="--v:@l.Score" title="Lead score: reachability, decision-maker title, company size, stage"><span>@l.Score</span></div>
            </div>
            <div class="card-body">
                <dl class="details">
                    <div><dt>Website</dt>@if (l.Website is null) { <dd class="unset">Not set</dd> } else { <dd><a href="@l.Website" target="_blank" rel="noopener">@l.Website.Replace("https://", "").Replace("http://", "")</a></dd> }</div>
                    <div><dt>Industry</dt><dd class="@(l.Industry is null ? "unset" : "")">@(l.Industry ?? "Not set")</dd></div>
                    <div><dt>Email</dt>@if (l.Email is null) { <dd class="unset">Not set</dd> } else { <dd><a href="mailto:@l.Email">@l.Email</a></dd> }</div>
                    <div><dt>Phone</dt><dd class="@(l.Phone is null ? "unset" : "")">@(l.Phone ?? "Not set")</dd></div>
                    <div><dt>Country</dt><dd class="@(l.Country is null ? "unset" : "")">@(l.Country ?? "Not set")</dd></div>
                    <div><dt>Employees</dt><dd class="@(l.Employees is null ? "unset" : "") num">@(l.Employees?.ToString() ?? "Not set")</dd></div>
                    <div><dt>Owner</dt><dd class="@(l.OwnerName is null ? "unset" : "")">@(l.OwnerName ?? "Unassigned")</dd></div>
                    <div><dt>Created</dt><dd>@l.CreatedAt.ToString("d MMM yyyy")</dd></div>
                    @if (!string.IsNullOrWhiteSpace(l.Notes)) { <div class="span-2"><dt>Notes</dt><dd style="font-weight:500;white-space:pre-wrap">@l.Notes</dd></div> }
                </dl>
            </div>
        </div>

        <div class="card">
            <details class="disclosure">
                <summary class="card-head">
                    <h2 class="card-title">Activity <span class="muted num" style="font-weight:600">@Model.Activities.Count</span></h2>
                    <span class="btn btn-secondary btn-sm"><span class="when-closed">Log activity</span><span class="when-open">Close</span></span>
                </summary>
                <div class="card-body" style="padding-bottom:0">
                    <form method="post" action="/leads/@l.Id/activities" class="form-grid composer">
                        @Html.AntiForgeryToken()
                        <div class="field"><label for="kind">Type</label>
                            <select id="kind" name="kind" class="select"><option value="call">Call</option><option value="email">Email</option><option value="linkedin">LinkedIn</option><option value="meeting">Meeting</option><option value="note">Note</option></select>
                        </div>
                        <div class="field"><label for="outcome">Outcome <span class="hint">optional</span></label><input id="outcome" name="outcome" class="input" placeholder="Replied, booked, no answer" /></div>
                        <div class="field span-2"><label for="summary">What happened</label><input id="summary" name="summary" class="input" required /></div>
                        <div class="form-actions span-2"><button class="btn btn-primary btn-sm" type="submit">Save</button></div>
                    </form>
                </div>
            </details>
            <div class="card-body flush">
                @if (Model.Activities.Count == 0) { <div class="empty">Nothing logged yet.</div> }
                <div class="list">
                    @foreach (var a in Model.Activities)
                    {
                        <div class="row">
                            <span class="kind @a.Kind.ToString().ToLowerInvariant()">@await Html.PartialAsync("_KindIcon", a.Kind)</span>
                            <span class="grow"><span class="title" style="font-weight:600;white-space:normal">@a.Summary</span><span class="sub">@(a.MemberName ?? "System")@(a.Outcome is null ? "" : " · " + a.Outcome)</span></span>
                            <span class="when">@a.OccurredAt.ToString("d MMM")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="stack">
        <div class="card">
            <div class="card-head"><h2 class="card-title">Stage</h2><span class="badge badge-@l.Stage.Key()"><span class="dot"></span>@l.Stage.Label()</span></div>
            <div class="card-body">
                <div class="stepper @(l.Stage == Stage.Disqualified ? "dq" : "")" aria-hidden="true">@for (var i = 0; i < order.Length; i++) { <span class="@(i < reached ? "on" : "")"></span> }</div>
                @if (next.Count == 0)
                {
                    <p class="muted">Handed to sales. This lead is done.</p>
                }
                else
                {
                    <form method="post" action="/leads/@l.Id/move" class="stack" style="gap:12px">
                        @Html.AntiForgeryToken()
                        <div class="field"><label for="to">Move to</label>
                            <select id="to" name="to" class="select">@foreach (var s in next) { <option value="@s.Key()">@s.Label()</option> }</select>
                        </div>
                        <div class="field"><label for="reason">Note <span class="hint">required to disqualify</span></label><input id="reason" name="reason" class="input" /></div>
                        <button class="btn btn-primary" type="submit">Move lead</button>
                    </form>
                    @if (l.Stage == Stage.Researching) { <p class="hint" style="margin-top:12px">To validate: no pending suggestions, a contact name, and an email or phone.</p> }
                }
            </div>
        </div>

        <div class="card">
            <div class="card-head"><h2 class="card-title">History</h2></div>
            <div class="card-body">
                <div class="timeline">
                    @foreach (var e in Model.History)
                    {
                        <div class="tl">
                            <span class="dot @e.To.Key()"></span>
                            <div>
                                <div class="t">@(e.From is null ? "Created" : e.To.Label())</div>
                                <div class="s">@e.CreatedAt.ToString("d MMM, HH:mm") · @(e.MemberName ?? "System")@(string.IsNullOrEmpty(e.Reason) || e.From is null ? "" : $" · {e.Reason}")</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (Model.Reviewed.Any())
        {
            <div class="card">
                <div class="card-head"><h2 class="card-title">Reviewed suggestions</h2></div>
                <div class="card-body flush">
                    @foreach (var s in Model.Reviewed)
                    {
                        <div class="row">
                            <span class="grow"><span class="title" style="font-weight:600">@s.FieldLabel: @s.SuggestedValue</span><span class="sub">@(s.ReviewerName ?? "Someone") · @s.ReviewedAt?.ToString("d MMM")</span></span>
                            <span class="badge @(s.Status == SuggestionStatus.Accepted ? "badge-ok" : "badge-bad")">@s.Status</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>
