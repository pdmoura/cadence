@model DashboardViewModel
@{
    var local = DateTimeOffset.UtcNow;
    try { if (Model.Me is not null) local = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, TimeZoneInfo.FindSystemTimeZoneById(Model.Me.Timezone)); } catch { }
    var greeting = local.Hour < 5 ? "Good evening" : local.Hour < 12 ? "Good morning" : local.Hour < 18 ? "Good afternoon" : "Good evening";
    var first = Model.Me?.Name.Split(' ')[0];
    ViewData["Title"] = first is null ? greeting : $"{greeting}, {first}";
}
@section Meta {
    <span>@local.ToString("dddd, d MMMM")</span>
    @if (Model.PendingSuggestions > 0) { <span class="faint sep">·</span><a class="card-link" href="/leads?pending=true">@Model.PendingSuggestions suggestions need a decision</a> }
}
@section Actions {
    <a class="btn btn-secondary" href="/standups"><svg class="ic" viewBox="0 0 24 24"><path d="M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg><span class="label">@(Model.MyStandup is null ? "Post stand-up" : "Stand-up")</span></a>
    <a class="btn btn-primary" href="/leads/new"><svg class="ic" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg><span class="label">New lead</span></a>
}

<section class="grid grid-kpi">
    <a class="card stat" href="/leads">
        <span class="stat-label">Open leads</span>
        <span class="stat-value">@Model.TotalOpen</span>
        <span class="stat-hint">@Model.ByStage[Stage.New] new, @Model.ByStage[Stage.Researching] in research</span>
    </a>
    <a class="card stat @(Model.PendingSuggestions > 0 ? "accent" : "")" href="/leads?pending=true">
        <span class="stat-label">To review</span>
        <span class="stat-value">@Model.PendingSuggestions</span>
        <span class="stat-hint">AI suggestions</span>
    </a>
    <a class="card stat" href="/reports">
        <span class="stat-label">Validated this week</span>
        <span class="stat-value">@Model.ValidatedThisWeek</span>
        <span class="stat-hint">@Model.QualifiedThisWeek qualified</span>
    </a>
    <a class="card stat" href="/reports">
        <span class="stat-label">Touches, 24h</span>
        <span class="stat-value">@Model.ActivitiesToday</span>
        <span class="stat-hint">calls, emails, meetings</span>
    </a>
</section>

<section class="card">
    <div class="card-head">
        <h2 class="card-title">Pipeline</h2>
        <span class="muted num">@Model.ByStage.Values.Sum() leads</span>
    </div>
    <div class="card-body">
        <div class="stackbar" role="img" aria-label="Leads by stage">
            @foreach (var s in Stages.Ordered.Where(s => Model.ByStage[s] > 0))
            {
                <a class="seg-@s.Key()" href="/leads?stage=@s.Key()" style="flex:@Model.ByStage[s]" title="@s.Label(): @Model.ByStage[s]"></a>
            }
        </div>
        <div class="legend">
            @foreach (var s in Stages.Ordered)
            {
                <a href="/leads?stage=@s.Key()"><span class="l"><i class="seg-@s.Key()"></i>@s.Label()</span><span class="n">@Model.ByStage[s]</span></a>
            }
        </div>
    </div>
</section>

<section class="grid grid-main">
    <div class="card">
        <div class="card-head">
            <h2 class="card-title">Needs your decision</h2>
            <a class="card-link" href="/leads?pending=true">View all</a>
        </div>
        <div class="card-body flush">
            @if (Model.NeedsReview.Count == 0)
            {
                <div class="empty"><b>All clear</b>Every suggestion has been reviewed.</div>
            }
            <div class="list">
                @foreach (var l in Model.NeedsReview)
                {
                    <a class="row" href="/leads/@l.Id">
                        <span class="avatar sm @(l.OwnerName is null ? "idle" : "")" aria-hidden="true">@(l.OwnerName is null ? "?" : string.Concat(l.OwnerName.Split(' ').Take(2).Select(p => p[0])))</span>
                        <span class="grow">
                            <span class="title">@l.Company</span>
                            <span class="sub">@(l.ContactName ?? "No contact yet")</span>
                        </span>
                        <span class="badge badge-@l.Stage.Key() hide-sm"><span class="dot"></span>@l.Stage.Label()</span>
                        <span class="pill" title="Pending suggestions">@l.PendingSuggestions</span>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="stack">
        <div class="card">
            <div class="card-head">
                <h2 class="card-title">Your stand-up</h2>
                <span class="muted num">@Model.StandupsToday/@Model.TeamSize posted</span>
            </div>
            <div class="card-body">
                @if (Model.MyStandup is null)
                {
                    <p class="muted" style="margin-bottom:14px">Five quick questions before the daily meeting.</p>
                    <a class="btn btn-primary btn-sm" href="/standups">Post stand-up</a>
                }
                else
                {
                    <dl class="qa">
                        <dt>Today</dt><dd>@Model.MyStandup.Today</dd>
                        @if (!string.IsNullOrWhiteSpace(Model.MyStandup.Blockers)) { <dt>Blocked</dt><dd class="blocker">@Model.MyStandup.Blockers</dd> }
                    </dl>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-head"><h2 class="card-title">Latest activity</h2></div>
            <div class="card-body flush">
                <div class="list">
                    @foreach (var (a, company) in Model.Recent.Take(5))
                    {
                        <a class="row" href="/leads/@a.LeadId">
                            <span class="kind @a.Kind.ToString().ToLowerInvariant()">@await Html.PartialAsync("_KindIcon", a.Kind)</span>
                            <span class="grow"><span class="title" style="font-weight:600">@a.Summary</span><span class="sub">@company · @(a.MemberName ?? "System")</span></span>
                            <span class="when">@Relative(a.OccurredAt)</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@functions {
    static string Relative(DateTimeOffset t)
    {
        var d = DateTimeOffset.UtcNow - t;
        if (d.TotalMinutes < 60) return $"{Math.Max(1, (int)d.TotalMinutes)}m";
        if (d.TotalHours < 24) return $"{(int)d.TotalHours}h";
        return $"{(int)d.TotalDays}d";
    }
}
